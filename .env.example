# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore.
# Las variables EXPO_PUBLIC_* se embeben en el bundle del cliente (no son secretos:
# los OAuth Client IDs de Google son identificadores públicos).

# URL base del backend .NET.
# - iOS Simulator / web: http://localhost:5247
# - Emulador Android:    http://10.0.2.2:5247
# - Dispositivo físico:  http://<IP-LAN-de-tu-maquina>:5247  (ej. http://192.168.1.50:5247)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5247

# OAuth Client IDs de Google Cloud Console (uno por plataforma).
# El `aud` del ID Token emitido debe coincidir con `ValidAudience` (Google:ClientId) del backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
